# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
# docker compose liest .env automatisch, die Einstellungen bleiben also bei jedem Neustart/Update erhalten.

# Port auf dem Host (für Port-Weiterleitung / Reverse Proxy)
RIFTGALLERY_PORT=3001

# Auf welcher Adresse der Port geöffnet wird:
#   0.0.0.0   = von überall erreichbar, z. B. http://kumilan.com:3001 (Port im Router freigeben)
#   127.0.0.1 = nur über nginx auf dem Server (z. B. https://riftbound.kumilan.com) – sicherer,
#               weil Passwörter dann nur verschlüsselt übertragen werden
RIFTGALLERY_BIND=0.0.0.0
